# ==============================================================================
# KONFIGURASI ENVIRONMENT KHUSUS UNTUK CPANEL (MYSQL DATABASE)
# ==============================================================================
# Salin seluruh isi file ini ke menu "Setup Node.js App" di cPanel
# atau simpan sebagai file .env di folder aplikasi cPanel Anda (/home/username/spmi-app/.env)
# ==============================================================================

# 1. RUNTIME PRODUCTION
NODE_ENV="production"
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# 2. DOMAIN WEBSITE CPANEL ANDA
# Ganti dengan domain/subdomain resmi Anda (contoh: https://spmi.unpal.ac.id)
NEXT_PUBLIC_APP_URL="https://spmi.unpal.ac.id"

# 3. KONEKSI DATABASE MYSQL CPANEL
# Pada cPanel, nama database dan nama user diawali username cPanel (unpx1994)
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="unpx1994_jemiarian"
MYSQL_PASSWORD="Spmiunpal!23."
MYSQL_DATABASE="unpx1994_spmi-unpal"

# Atau format URL tunggal MySQL:
MYSQL_URL="mysql://unpx1994_jemiarian:Spmiunpal!23.@localhost:3306/unpx1994_spmi-unpal"
DATABASE_URL="mysql://unpx1994_jemiarian:Spmiunpal!23.@localhost:3306/unpx1994_spmi-unpal"

# 4. BRANDING & IDENTITAS INSTITUSI
NEXT_PUBLIC_INSTITUTION_NAME="Universitas Palembang"
NEXT_PUBLIC_APP_NAME="SPMI UNPAL"
NEXT_PUBLIC_CONTACT_EMAIL="spmi@unpal.ac.id"
NEXT_PUBLIC_CONTACT_PHONE="(0711) 512345"
NEXT_PUBLIC_CONTACT_WHATSAPP="+62 812-7389-9900"
