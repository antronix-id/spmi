# ==============================================================================
# KONFIGURASI ENVIRONMENT KHUSUS UNTUK CPANEL (TANPA SUPABASE)
# ==============================================================================
# Salin seluruh isi file ini ke menu "Setup Node.js App" di cPanel
# atau simpan sebagai file .env di folder aplikasi cPanel Anda (/home/user/spmi-app/.env)
# ==============================================================================

# 1. RUNTIME PRODUCTION
NODE_ENV="production"
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# 2. DOMAIN WEBSITE CPANEL ANDA
# Ganti dengan domain/subdomain resmi kampus Anda
NEXT_PUBLIC_APP_URL="https://spmi.unpal.ac.id"

# 3. KONEKSI DATABASE POSTGRESQL CPANEL
# Format: postgresql://[USER_DB]:[PASSWORD_DB]@localhost:5432/[NAMA_DB]
# Contoh: Jika username cPanel Anda adalah 'unpalac', maka nama DB & User biasanya berawalan 'unpalac_'
DATABASE_URL="postgresql://unpalac_spmi_user:PasswordKuatDatabase2026!@localhost:5432/unpalac_spmi_db"

# 4. BRANDING & IDENTITAS (OPSIONAL)
NEXT_PUBLIC_INSTITUTION_NAME="Universitas Palembang"
NEXT_PUBLIC_APP_NAME="SPMI UNPAL"
NEXT_PUBLIC_CONTACT_EMAIL="spmi@unpal.ac.id"
NEXT_PUBLIC_CONTACT_PHONE="(0711) 512345"
NEXT_PUBLIC_CONTACT_WHATSAPP="+62 812-7389-9900"
