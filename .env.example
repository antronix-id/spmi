# ==============================================================================
# TEMPLATE ENVIRONMENT VARIABLES - SPMI UNIVERSITAS PALEMBANG
# ==============================================================================

# 1. RUNTIME & DOMAIN
NODE_ENV="production"
PORT=3000
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL="https://spmi.unpal.ac.id"

# 2. DATABASE POSTGRESQL (PILIH SALAH SATU)
# Supabase Pooler:
# DATABASE_URL="postgresql://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# cPanel PostgreSQL:
# DATABASE_URL="postgresql://username_dbuser:password@localhost:5432/username_dbname"

# 3. SUPABASE API KEYS
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# 4. BRANDING & CONTACT
NEXT_PUBLIC_INSTITUTION_NAME="Universitas Palembang"
NEXT_PUBLIC_APP_NAME="SPMI UNPAL"
NEXT_PUBLIC_CONTACT_EMAIL="spmi@unpal.ac.id"
NEXT_PUBLIC_CONTACT_PHONE="(0711) 512345"
NEXT_PUBLIC_CONTACT_WHATSAPP="+62 812-7389-9900"
